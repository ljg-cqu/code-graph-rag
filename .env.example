# Model Provider Configuration

# Example 1: All Ollama (local)
# ORCHESTRATOR_PROVIDER=ollama
# ORCHESTRATOR_MODEL=llama3.2
# ORCHESTRATOR_ENDPOINT=http://localhost:11434/v1

# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=codellama
# CYPHER_ENDPOINT=http://localhost:11434/v1

# Example 2: All OpenAI
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-4o
# ORCHESTRATOR_API_KEY=sk-your-openai-key

# CYPHER_PROVIDER=openai
# CYPHER_MODEL=gpt-4o-mini
# CYPHER_API_KEY=sk-your-openai-key

# Example 3: All Google (AI Studio)
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# ORCHESTRATOR_API_KEY=your-google-api-key

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-2.5-flash
# CYPHER_API_KEY=your-google-api-key
# Example 4: Google Vertex AI
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# ORCHESTRATOR_PROJECT_ID=your-gcp-project-id
# ORCHESTRATOR_REGION=us-central1
# ORCHESTRATOR_PROVIDER_TYPE=vertex
# ORCHESTRATOR_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-2.5-flash
# CYPHER_PROJECT_ID=your-gcp-project-id
# CYPHER_REGION=us-central1
# CYPHER_PROVIDER_TYPE=vertex
# CYPHER_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Example 5: Mixed - Google orchestrator + Ollama cypher
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# ORCHESTRATOR_API_KEY=your-google-api-key

# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=codellama
# CYPHER_ENDPOINT=http://localhost:11434/v1

# Example 6: Mixed - OpenAI orchestrator + Google cypher
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-4o
# ORCHESTRATOR_API_KEY=sk-your-openai-key

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-2.5-flash
# CYPHER_API_KEY=your-google-api-key

# Thinking budget for reasoning models (optional)
# ORCHESTRATOR_THINKING_BUDGET=10000
# CYPHER_THINKING_BUDGET=5000

# Memgraph settings
# SECURITY WARNING: In production, always set MEMGRAPH_USERNAME and MEMGRAPH_PASSWORD
# and bind MEMGRAPH_HOST to localhost only (never 0.0.0.0) to prevent unauthorized access
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_HTTP_PORT=7444
# Memgraph authentication credentials
# Leave MEMGRAPH_USERNAME empty (or omit it) if your Memgraph instance doesn't require authentication
# If authentication is enabled, provide both username and password
# Common defaults: username=neo4j, password=password (or your custom credentials)
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
LAB_PORT=3000
MEMGRAPH_BATCH_SIZE=1000

# Repository settings
TARGET_REPO_PATH=.
# Number of parallel workers to use for codebase indexing (default: 20)
# Auto-optimized at runtime: will never exceed available CPU cores or number of changed files
# Set to 1 to disable parallel indexing entirely (run sequentially)
# Uses perfect round-robin load distribution across workers for balanced throughput
PARALLEL_INDEXING_WORKERS=20

# ============================================
# Session Behavior Settings
# ============================================

# Yolo mode: Auto-approve all tool operations without confirmation
# When enabled, file edits, shell commands, and other operations are auto-approved
# Warning: Use with caution on production codebases
# CLI flags --yolo or --no-confirm take precedence over this setting
CGR_YOLO_MODE=false

# Quiet mode: Suppress non-essential output (progress messages, banners)
CGR_QUIET=false

# Ollama base URL (without /v1 suffix)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Vector Store Backend Configuration
# ============================================

# ONLY Memgraph native vector storage is supported (Qdrant deprecated and removed)
# All embeddings are stored directly on graph nodes for atomic hybrid vector+graph queries
# No external vector database dependencies required
MEMGRAPH_VECTOR_INDEX_NAME=code_embeddings  # Used for logging/identification
MEMGRAPH_VECTOR_DIM=768              # Must match embedding model (768 for UniXcoder)
MEMGRAPH_VECTOR_CAPACITY=100000      # REQUIRED - estimate ~2x your function count
MEMGRAPH_VECTOR_METRIC=cos           # Options: l2sq, cos, ip, pearson
MEMGRAPH_VECTOR_SCALAR_KIND=f32      # Options: f32, f64, f16, bf16, f8

# ============================================
# Graph Algorithm Configuration
# ============================================

# Enable/disable automatic post-ingestion algorithm runs (default: true)
# Runs ANALYZE GRAPH, PageRank, and Community Detection after every ingestion
ALGORITHM_RUN_POST_INGESTION=true

# Enable PageRank calculation (improves retrieval ranking by identifying important nodes)
ALGORITHM_ENABLE_PAGERANK=true

# Enable Community Detection (groups related code entities, improves global query performance)
ALGORITHM_ENABLE_COMMUNITY_DETECTION=true
# Community detection algorithm to use: "leiden" (higher quality, default) or "louvain" (faster for large graphs)
ALGORITHM_COMMUNITY_ALGORITHM=leiden

# Embedding Cache (backend-agnostic)
# Stores embedding computation cache for faster subsequent runs
EMBEDDING_CACHE_DIR=./.embedding_cache

# ============================================
# Embedding Provider Configuration
# ============================================

# Default: Local UniXcoder (no API key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=microsoft/unixcoder-base
EMBEDDING_DEVICE=auto  # auto, cpu, or cuda

# Example: OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-your-openai-key

# Example: Aliyun/Dashscope embeddings (OpenAI-compatible API)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=sk-your-aliyun-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# MEMGRAPH_VECTOR_DIM=1024  # text-embedding-v4 uses 1024 dimensions

# Example: Ollama local embeddings
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_KEEP_ALIVE=5m

# Example: Google embeddings
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_API_KEY=your-google-api-key

# Unified Vector Settings (apply to both backends)
VECTOR_SEARCH_TOP_K=5
VECTOR_EMBEDDING_BATCH_SIZE=50

# ============================================
# Document GraphRAG Configuration
# ============================================

# Document graph database (separate instance for isolation)
# SECURITY WARNING: In production, always set DOC_MEMGRAPH_USERNAME and DOC_MEMGRAPH_PASSWORD
# and bind DOC_MEMGRAPH_HOST to localhost only (never 0.0.0.0) to prevent unauthorized access
DOC_MEMGRAPH_HOST=localhost
DOC_MEMGRAPH_PORT=7688
DOC_MEMGRAPH_USERNAME=
DOC_MEMGRAPH_PASSWORD=
DOC_MEMGRAPH_MEMORY_LIMIT=2GB

# Document graph Lab UI (Memgraph Lab for document graph)
DOC_LAB_PORT=3001

# Document vector backend (mirrors code graph config)
DOC_VECTOR_STORE_BACKEND=memgraph
DOC_MEMGRAPH_VECTOR_INDEX_NAME=doc_embeddings
DOC_MEMGRAPH_VECTOR_CAPACITY=100000
DOC_VECTOR_SEARCH_TOP_K=5

# Document indexing settings
DOC_ENABLED=true
DOC_SUPPORTED_EXTENSIONS=[".md", ".rst", ".txt", ".pdf", ".docx"]
DOC_ENABLE_PDF_EXTRACTION=true
DOC_MAX_FILE_SIZE_MB=50
DOC_EXTRACTION_TIMEOUT_SECONDS=30

# ============================================
# JSON Graph Configuration
# ============================================
# JSON graph database (separate instance for isolation)
# SECURITY WARNING: In production, always set JSON_MEMGRAPH_USERNAME and JSON_MEMGRAPH_PASSWORD
# and bind JSON_MEMGRAPH_HOST to localhost only (never 0.0.0.0) to prevent unauthorized access
JSON_MEMGRAPH_HOST=localhost
JSON_MEMGRAPH_PORT=7689
JSON_MEMGRAPH_USERNAME=
JSON_MEMGRAPH_PASSWORD=
JSON_MEMGRAPH_MEMORY_LIMIT=2GB

# JSON graph Lab UI (Memgraph Lab for JSON graph)
JSON_LAB_PORT=3002

# JSON vector backend (mirrors code graph config)
JSON_VECTOR_STORE_BACKEND=memgraph
JSON_MEMGRAPH_VECTOR_INDEX_NAME=json_embeddings
JSON_MEMGRAPH_VECTOR_CAPACITY=100000
JSON_VECTOR_SEARCH_TOP_K=5

# JSON ingestion parallel worker count (uses round-robin connection pool for load balancing)
# Adjust based on your workload and Memgraph instance capacity
JSON_PARALLEL_WORKERS=10

# ============================================
# Parallel Sub-Agent Worker LLM Configuration
# ============================================
# Configure dedicated LLMs for parallel sub-agent workers
# If no worker LLMs are configured, sub-agents automatically use the orchestrator LLM
# The dedicated Cypher LLM remains unchanged and is shared by all workers for graph queries

# Example 1: Simple comma-separated format (uses default provider credentials for each model)
# CGR_WORKER_LLMS="openai:gpt-4o-mini,anthropic:claude-3-haiku,ollama:llama3.2"

# Example 2: Full JSON array format (specify custom credentials/endpoints per model)
# CGR_WORKER_LLMS='[
#     {"provider": "openai", "model_id": "gpt-4o-mini", "api_key": "sk-your-key", "endpoint": "https://api.openai.com/v1"},
#     {"provider": "anthropic", "model_id": "claude-3-haiku-20240307", "api_key": "sk-ant-your-key"},
#     {"provider": "ollama", "model_id": "llama3.2", "endpoint": "http://localhost:11434/v1"}
# ]'

# LLM assignment strategy for sub-agents: only "round-robin" is supported currently
# Distributes configured LLMs evenly across workers for optimal load balancing
CGR_WORKER_LLM_ASSIGNMENT_STRATEGY=round-robin

# ============================================
# Automatic Parallel Execution Configuration
# ============================================
# Enable/disable automatic parallel execution detection (no explicit user request needed)
# When enabled, the system automatically detects parallelizable tasks and activates 10 round-robin workers
# to speed up execution by up to 10x, no user intervention required
CGR_AUTO_PARALLEL_ENABLED=true

# Default number of parallel workers (fixed to 10 as per default configuration)
# Uses strict round-robin task assignment for even load distribution
CGR_DEFAULT_PARALLEL_WORKERS=10

# Maximum allowed parallel workers (override with CGR_ALLOW_DYNAMIC_MAX_OVERRIDE=true)
CGR_MAX_PARALLEL_WORKERS=20

# Allow overriding the max worker limit for large workloads
CGR_ALLOW_DYNAMIC_MAX_OVERRIDE=true

# Automatically scale worker count to match number of subtasks (no more workers than subtasks)
CGR_AUTO_SCALE_WORKERS=true

# Confidence threshold for automatic parallel activation (0.0-1.0)
# Only activates parallel when detection confidence is >= this value
CGR_PARALLEL_ELIGIBILITY_THRESHOLD=0.8

# Maximum size of the parallel task queue, falls back to sequential when full
CGR_PARALLEL_MAX_QUEUE_SIZE=100

# Timeout per subtask execution (seconds)
CGR_SUBAGENT_TIMEOUT=300

# Allow sub-agents to perform write operations (default: false for safety)
# Write operations are always executed sequentially to prevent corruption
CGR_SUBAGENT_ALLOW_WRITE=false

# Enable automatic task splitting for parallel execution
CGR_AUTO_SPLIT_ENABLED=true

# Number of retry attempts for failed subtasks
CGR_SUBAGENT_RETRY_ATTEMPTS=2

# ============================================
# Intelligent Context Window Compression
# ============================================
# Automatically prevents LLM context window overflow with zero semantic loss for critical content
# Uses 10 parallel round-robin workers to select optimal compression strategy per scenario
# All features are enabled by default with optimal production settings, no configuration needed

# Percentage of context window usage that triggers automatic compression (default: 85.0)
# Runs before any LLM call that would exceed the limit, preventing failure entirely
# CONTEXT_COMPRESSION_AUTO_TRIGGER_PCT=85.0

# Hysteresis buffer percentage to avoid repeated compression cycles when context hovers near the limit (default:5.0)
# Only recompression only runs again when usage drops below (trigger - hysteresis) then rises back to trigger
# CONTEXT_COMPRESSION_HYSTERESIS_PCT=5.0

# Minimum acceptable semantic retention score percentage (default: 70.0)
# If best compression strategy achieves lower than this score, automatically roll back to original context
# CONTEXT_COMPRESSION_MIN_RETENTION_SCORE=70.0

# Number of parallel round-robin workers to use for strategy evaluation (default: 10)
# Use 20 for higher throughput on large workloads
# CONTEXT_COMPRESSION_PARALLEL_WORKERS=10

# Minimum retention threshold for aggressive compression mode (default: 50.0)
# Lower values allow higher compression ratios with lower semantic retention
# CONTEXT_COMPRESSION_AGGRESSIVE_RETENTION_THRESHOLD=50.0

# How long to keep compressed context archives for restore capability (hours, default: 24)
# Archives are automatically deleted after this time to save storage
# CONTEXT_COMPRESSION_ARCHIVE_TTL_HOURS=24

# Enable/disable context compression entirely (default: true)
# CONTEXT_COMPRESSION_ENABLED=true